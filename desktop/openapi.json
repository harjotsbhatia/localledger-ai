            "title": "Total Count",
            "type": "integer"
          },
          "transactions": {
            "items": {
              "$ref": "#/components/schemas/Transaction"
            },
            "title": "Transactions",
            "type": "array"
          }
        },
        "required": [
          "total_count",
          "net_amount_minor",
          "transactions"
        ],
        "title": "TransactionPage",
        "type": "object"
      },
      "ValidationError": {
        "properties": {
