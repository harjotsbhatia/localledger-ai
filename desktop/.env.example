# Only used when running the UI in a plain browser (pnpm dev) instead of the Tauri shell.
# Inside the desktop app the shell generates a fresh token on every launch.
# Never put real secrets here; this token only protects a local development backend.
VITE_BACKEND_URL=http://127.0.0.1:8765
VITE_BACKEND_TOKEN=replace-with-a-random-32+-character-dev-token
