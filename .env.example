# LocalLedger needs no secrets to run. These are optional development switches for the
# backend sidecar. Never commit a real .env file.

# Where the encrypted database lives (default: ~/Library/Application Support/ai.localledger.app)
# LOCALLEDGER_DATA_DIR=/tmp/localledger-dev

# Development only: allow the Vite dev origin and log request paths (never bodies/queries).
# LOCALLEDGER_DEV=1

# DANGER, development only: store data in plain, UNENCRYPTED SQLite. Never use with real data.
# LOCALLEDGER_INSECURE_DEV_DB=1
